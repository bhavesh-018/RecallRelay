# RecallRelay Backend & Frontend Configuration
APP_NAME=RecallRelay API
APP_ENV=development
APP_PORT=8080
PUBLIC_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Application PostgreSQL
DATABASE_URL=postgresql+psycopg://recallrelay:recallrelay@localhost:5432/recallrelay

# Flagsmith (Cloud default; for self-hosted set API_URL=http://localhost:8000/api/v1/ and EVENTS_URL=http://localhost:8000/api/)
FLAGSMITH_API_URL=https://edge.api.flagsmith.com/api/v1/
FLAGSMITH_EVENTS_URL=https://events.api.flagsmith.com/
FLAGSMITH_ADMIN_API_URL=https://api.flagsmith.com/api/v1/
FLAGSMITH_STUDY_KEY=
FLAGSMITH_PILOT_KEY=
FLAGSMITH_MANAGEMENT_TOKEN=
FLAGSMITH_PILOT_ENV_ID=
FLAGSMITH_PILOT_FEATURE_NAME=recall_response_flow

# Operator Auth
OPERATOR_SECRET=dev-operator-secret-change-me

# Bounded Product Agent LLM
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
